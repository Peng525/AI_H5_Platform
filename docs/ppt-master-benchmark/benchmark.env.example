# PPT Master 多模型横评 — 环境变量说明
# 复制 develop/.env.example 为 develop/.env 后，按下列项填写。
# 真实密钥勿提交 Git。

# =============================================================================
# 一、中转模型（Gemini / Claude / GPT）— 复用 H5 平台已有配置
# =============================================================================
# 用于 active_profile: gemini-3-pro | claude-opus-4-8 | claude-opus-4-7 | gpt-5-5
LLM_RELAY_BASE_URL=https://你的中转地址/v1
LLM_RELAY_API_KEY=你的推理令牌

# Phase 2 配图（可选，与 H5 生图通道一致）
LLM_IMAGE_MODEL_FREE=gpt-image-2
LLM_IMAGE_MODEL_PRO=gpt-image-2

# =============================================================================
# 二、DeepSeek 官方直连 — 仅 Cursor / ppt-master 横评使用
# =============================================================================
# 用于 active_profile: deepseek-v4-pro
# 与 LLM_RELAY_* 分离，避免与 H5 后端通道混淆
base_url=https://api.deepseek.com/v1
api_key=
model=deepseek-v4-pro

# =============================================================================
# 三、与 model-profiles.yaml 的对应关系
# =============================================================================
# | active_profile     | Cursor Base URL      | Cursor API Key        | Cursor Model      |
# |--------------------|----------------------|-----------------------|-------------------|
# | gemini-3-pro       | LLM_RELAY_BASE_URL   | LLM_RELAY_API_KEY     | gemini-3.1-pro-preview |
# | claude-opus-4-8    | LLM_RELAY_BASE_URL   | LLM_RELAY_API_KEY     | claude-opus-4-8   |
# | claude-opus-4-7    | LLM_RELAY_BASE_URL   | LLM_RELAY_API_KEY     | claude-opus-4-7   |
# | gpt-5-5            | LLM_RELAY_BASE_URL   | LLM_RELAY_API_KEY     | gpt-5.5           |
# | deepseek-v4-pro    | base_url             | api_key               | model             |
