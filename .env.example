# AI 智能 H5 演示平台 — 环境变量（复制为 .env）

# =============================================================================
# 个人用户推荐配置（无商户号、无短信，开箱即用）
# =============================================================================
# JWT_SECRET=请更换为随机长字符串
# CAPTCHA_PROVIDER=mock
# ADMIN_USERNAMES=你的管理员邮箱
# WECHAT_PERSONAL_QR_URL=/static/wechat-pay-qr.png
# 收款码图片放到 backend/static/wechat-pay-qr.png
# 勿配置 WECHAT_PAY_*（需微信商户号，见文末「延后」）
# 勿配置 SMS 相关（登录仅支持邮箱 + 拼图）
# =============================================================================

APP_NAME=AI智能H5演示平台
APP_PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 大模型通道：auto | relay | official
LLM_DEFAULT_CHANNEL=auto
LLM_AUTO_ORDER=relay,official
LLM_TIMEOUT=120

# 中转 API（OpenAI 兼容，推荐用于 Gemini）
LLM_RELAY_BASE_URL=https://你的中转地址/v1
LLM_RELAY_API_KEY=
LLM_RELAY_MODEL=gemini-3.1-flash

# 官方 API（Google Gemini OpenAI 兼容端点）
LLM_OFFICIAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_OFFICIAL_API_KEY=
LLM_OFFICIAL_MODEL=gemini-3.1-flash

# 会员档位模型
LLM_MODEL_FREE=gemini-3.1-flash-image-preview
LLM_MODEL_PRO=gemini-3-pro-image-preview
LLM_IMAGE_MODEL_FREE=gemini-3.1-flash-image-preview
LLM_IMAGE_MODEL_PRO=gemini-3-pro-image-preview

JWT_SECRET=请更换为随机长字符串
JWT_EXPIRE_HOURS=168
FREE_QUOTA_PER_USER=5

ADMIN_USERNAMES=admin@ai-h5.com
ENV_PERSIST_PATH=../.env

# --- 登录：拼图验证（本地 mock，上线改 tencent）---
CAPTCHA_PROVIDER=mock
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET_KEY=

# --- 个人收款码（/upgrade 默认渠道，长期有效静态图）---
WECHAT_PERSONAL_QR_URL=/static/wechat-pay-qr.png
ORDER_PENDING_EXPIRE_MINUTES=2

# 中转 API 额度
RELAY_QUOTA_PROFILE=novai
RELAY_NOVAI_DASHBOARD_URL=https://once-cf.novai.su
RELAY_DASHBOARD_RECHARGE_URL=https://once-cf.novai.su/wallet
RELAY_QUOTA_API_URL=
RELAY_QUOTA_LOW_THRESHOLD=1.0
RELAY_QUOTA_USD_DIVISOR=500000

# =============================================================================
# 延后（有商户号 / 需手机号短信时再配置，个人用户可忽略）
# =============================================================================
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# SMS_PROVIDER=mock
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# WECHAT_PAY_NOTIFY_URL=https://YOUR_NGROK.ngrok-free.app/api/v1/支付/回调/wechat
