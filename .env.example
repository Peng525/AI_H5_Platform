# AI 智能 H5 演示平台 — 环境变量示例（复制为 .env 后填写）

# 应用
APP_NAME=AI智能H5演示平台
APP_PORT=8080

# 数据库（Docker 内默认 sqlite）
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 大模型默认通道：auto | relay | official
# auto：按 LLM_AUTO_ORDER 顺序尝试已配置的通道
LLM_DEFAULT_CHANNEL=auto
LLM_AUTO_ORDER=official,relay
LLM_TIMEOUT=120

# 中转 API（OpenAI 兼容）
LLM_RELAY_BASE_URL=https://your-relay.example/v1
LLM_RELAY_API_KEY=
LLM_RELAY_MODEL=gpt-4o-mini

# 官方 API
LLM_OFFICIAL_BASE_URL=https://api.openai.com/v1
LLM_OFFICIAL_API_KEY=
LLM_OFFICIAL_MODEL=gpt-4o-mini

# JWT（生产环境请更换）
JWT_SECRET=请更换为随机长字符串
