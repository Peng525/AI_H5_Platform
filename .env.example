# AI 智能 H5 演示平台 — 环境变量（复制为 .env）

APP_NAME=AI智能H5演示平台
APP_PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 大模型通道：auto | relay | official
LLM_DEFAULT_CHANNEL=auto
LLM_AUTO_ORDER=relay,official
LLM_TIMEOUT=120

# 中转 API（OpenAI 兼容，推荐用于 Gemini）
LLM_RELAY_BASE_URL=https://你的中转地址/v1
LLM_RELAY_API_KEY=
LLM_RELAY_MODEL=gemini-3.1-flash

# 官方 API（Google Gemini OpenAI 兼容端点）
LLM_OFFICIAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_OFFICIAL_API_KEY=
LLM_OFFICIAL_MODEL=gemini-3.1-flash

# 会员档位模型（免费默认 Flash + 免费配图；升级后 Pro）
LLM_MODEL_FREE=gemini-3.1-flash
LLM_MODEL_PRO=gemini-3-pro
LLM_IMAGE_MODEL_FREE=gemini-3.1-flash
LLM_IMAGE_MODEL_PRO=gemini-3-pro

JWT_SECRET=请更换为随机长字符串
FREE_QUOTA_PER_USER=5
